# Optional overrides — ninjaone-mcp has no required env vars.
# Authentication is per-request via HTTP headers:
#   X-Ninja-Client-Id      (required) — a NinjaOne API Services OAuth2 app's client id
#   X-Ninja-Client-Secret  (required) — that app's client secret
#   X-Ninja-Region         (optional) — us (default), eu, oc, ca, us2, or fed
# This server exchanges those per-request for a bearer token at NinjaOne's
# own /oauth/token endpoint on every call; it never stores or caches them.

MCP_HTTP_PORT=8080
MCP_HTTP_HOST=0.0.0.0
