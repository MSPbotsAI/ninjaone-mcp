# Optional overrides — ninjaone-mcp has no required env vars.
# Authentication is per-request via HTTP headers:
#   X-Ninja-Token       (required) — an already-exchanged OAuth2 bearer access token
#                        (the gateway does the OAuth2 exchange, not this server)
#   X-Ninja-Region      (optional) — us (default), eu, oc, ca, us2, or fed
#   X-Ninja-User-Token  (optional) — a second, user-context access token, needed
#                        only by ninjaone_run_script_on_device
# This server never talks to NinjaOne's /oauth/token endpoint and never
# stores or caches any of these — it only ever holds a token for the
# lifetime of one request.

MCP_HTTP_PORT=8080
MCP_HTTP_HOST=0.0.0.0
